#!/usr/bin/env bash
# Test stub for the GitHub CLI. Pull requests live in $GH_STUB_DB (JSON); git
# operations run against the bare repository $GH_STUB_ORIGIN, so merges and
# branch updates are real. CI results come from marker files in a commit:
#   .ci-fail       PR checks fail
#   .ci-flaky      PR checks fail until the run is rerun once
#   .ci-hang       PR checks stay pending
#   .ci-none       no checks are reported
#   .ci-fail-base  PR checks pass; CI on the base branch commit fails
# The do_* functions run through in_clone.
# shellcheck disable=SC2016,SC2329
set -u
DB="${GH_STUB_DB:?gh stub: GH_STUB_DB is not set}"
ORIGIN="${GH_STUB_ORIGIN:?gh stub: GH_STUB_ORIGIN is not set}"
[ -f "$DB" ] || { echo "gh stub: no database at $DB" >&2; exit 1; }

og() { git --git-dir="$ORIGIN" "$@"; }
db() { jq "$@" "$DB"; }
save() { jq "$@" "$DB" >"$DB.tmp" && mv -f "$DB.tmp" "$DB"; }
note() { save --arg l "$1" '.log += [$l]'; }

pos=()
jq_filter=""
head=""
base=""
title=""
body=""
method=""
match=""
commit=""
while [ $# -gt 0 ]; do
  case "$1" in
    --jq | -q) jq_filter="$2"; shift 2 ;;
    --head) head="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --title) title="$2"; shift 2 ;;
    --body | --comment) body="$2"; shift 2 ;;
    --body-file) body="$(cat "$2")"; shift 2 ;;
    --match-head-commit) match="$2"; shift 2 ;;
    --commit) commit="$2"; shift 2 ;;
    --json | --limit | --status) shift 2 ;;
    --squash | --merge | --rebase) method="${1#--}"; shift ;;
    -*) shift ;;
    *) pos+=("$1"); shift ;;
  esac
done

out() { if [ -n "$jq_filter" ]; then jq -r "$jq_filter"; else cat; fi; }
field() { db -r --argjson n "$1" ".prs[] | select(.number == \$n) | $2"; }
exists() { [ -n "$(field "$1" .number 2>/dev/null)" ]; }
head_sha() { og rev-parse -q --verify "refs/heads/$(field "$1" .head)" 2>/dev/null; }
has() { og cat-file -e "$1:$2" 2>/dev/null; }

bucket() {
  # bucket <sha>: none | pending | fail | pass
  local sha="$1" polls need
  [ -n "$sha" ] || { echo none; return; }
  if has "$sha" .ci-none; then echo none; return; fi
  polls="$(db -r --arg s "$sha" '.polls[$s] // 0')"
  need="$(db -r '.pending_polls // 0')"
  save --arg s "$sha" '.polls[$s] = ((.polls[$s] // 0) + 1)'
  if has "$sha" .ci-hang || [ "$polls" -lt "$need" ]; then
    echo pending
  elif has "$sha" .ci-fail; then
    echo fail
  elif has "$sha" .ci-flaky && [ "$(db -r --arg s "$sha" '.reruns[$s] // false')" != "true" ]; then
    echo fail
  else
    echo pass
  fi
}

# in_clone <command...>: run a command in a throwaway clone of the origin.
in_clone() {
  local tmp rc
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/gh-stub.XXXXXX")"
  git clone -q "$ORIGIN" "$tmp/c" 2>/dev/null || { rm -rf "$tmp"; return 1; }
  (
    cd "$tmp/c" || exit 1
    git config user.email stub@example.com
    git config user.name "gh stub"
    git config commit.gpgsign false
    "$@"
  )
  rc=$?
  rm -rf "$tmp"
  return "$rc"
}

do_merge() {
  # do_merge <base> <head> <message>
  git checkout -q "$1" && git merge -q --squash "origin/$2" >/dev/null 2>&1 &&
    git commit -q -m "$3" && git push -q origin "$1" 2>/dev/null
}

do_update() {
  # do_update <base> <head>
  git checkout -q "$2" && git merge -q --no-edit "origin/$1" >/dev/null 2>&1 &&
    git push -q origin "$2" 2>/dev/null
}

do_revert() {
  # do_revert <base> <sha> <branch>
  git checkout -q -b "$3" "origin/$1" && git revert --no-edit "$2" >/dev/null 2>&1 &&
    git push -q origin "$3" 2>/dev/null
}

group="${pos[0]:-}"
cmd="${pos[1]:-}"
arg="${pos[2]:-}"

case "$group $cmd" in
  "auth status")
    echo "Logged in to github.com account stub"
    ;;

  "repo view")
    db '.repo' | out
    ;;

  "api "*)
    case "$cmd" in
      */commits/*/check-runs)
        sha="${cmd%/check-runs}"
        sha="${sha##*/}"
        if has "$sha" .ci-fail-base; then
          echo '{"check_runs":[{"name":"test","status":"completed","conclusion":"failure"}]}' | out
        else
          echo '{"check_runs":[{"name":"test","status":"completed","conclusion":"success"}]}' | out
        fi
        ;;
      *) echo "gh stub: unsupported api call $cmd" >&2; exit 1 ;;
    esac
    ;;

  "pr create")
    [ -n "$head" ] && [ -n "$base" ] || { echo "gh stub: pr create needs --head and --base" >&2; exit 1; }
    og rev-parse -q --verify "refs/heads/$head" >/dev/null || { echo "gh stub: head branch $head is not on the remote" >&2; exit 1; }
    n="$(db -r '.next')"
    save --argjson n "$n" --arg h "$head" --arg b "$base" --arg t "$title" --arg body "$body" \
      '.next += 1 | .prs += [{number: $n, head: $h, base: $b, title: $t, body: $body, state: "OPEN", mergeCommit: null}]'
    note "create $n $head"
    echo "https://github.com/example/fixture/pull/$n"
    ;;

  "pr view")
    exists "$arg" || { echo "gh stub: no pull request $arg" >&2; exit 1; }
    sha="$(head_sha "$arg")"
    mergeable="MERGEABLE"
    if [ "$(field "$arg" .state)" = "OPEN" ] && [ -n "$sha" ]; then
      og merge-tree --write-tree "refs/heads/$(field "$arg" .base)" "$sha" >/dev/null 2>&1 || mergeable="CONFLICTING"
    fi
    db --argjson n "$arg" --arg sha "$sha" --arg m "$mergeable" '.prs[] | select(.number == $n) |
      {number, state, title, body, mergeable: $m, headRefOid: $sha, headRefName: .head, baseRefName: .base,
       mergeCommit: (if .mergeCommit then {oid: .mergeCommit} else null end),
       url: "https://github.com/example/fixture/pull/\(.number)"}' | out
    ;;

  "pr checks")
    exists "$arg" || { echo "gh stub: no pull request $arg" >&2; exit 1; }
    b="$(bucket "$(head_sha "$arg")")"
    if [ "$b" = "none" ]; then
      echo "no checks reported on the '$(field "$arg" .head)' branch" >&2
      exit 1
    fi
    jq -n --arg b "$b" '[{name: "test", bucket: $b}]' | out
    case "$b" in pending) exit 8 ;; fail) exit 1 ;; esac
    ;;

  "pr merge")
    exists "$arg" || { echo "gh stub: no pull request $arg" >&2; exit 1; }
    [ "$(field "$arg" .state)" = "OPEN" ] || { echo "gh stub: pull request $arg is not open" >&2; exit 1; }
    sha="$(head_sha "$arg")"
    if [ -n "$match" ] && [ "$match" != "$sha" ]; then
      echo "gh stub: head commit does not match" >&2
      exit 1
    fi
    if [ "$(db -r '.refuse_merge // false')" = "true" ]; then
      echo "gh stub: merge refused by branch rules" >&2
      exit 1
    fi
    b="$(field "$arg" .base)"
    in_clone do_merge "$b" "$(field "$arg" .head)" "$(field "$arg" .title) (#$arg)" || { echo "gh stub: merge failed" >&2; exit 1; }
    save --argjson n "$arg" --arg sha "$(og rev-parse "refs/heads/$b")" \
      '(.prs[] | select(.number == $n)) |= (.state = "MERGED" | .mergeCommit = $sha)'
    note "merge $arg ${method:-default} $(bucket "$sha")"
    ;;

  "pr update-branch")
    exists "$arg" || { echo "gh stub: no pull request $arg" >&2; exit 1; }
    note "update-branch $arg"
    in_clone do_update "$(field "$arg" .base)" "$(field "$arg" .head)" || { echo "gh stub: update-branch hit a conflict" >&2; exit 1; }
    ;;

  "pr revert")
    exists "$arg" || { echo "gh stub: no pull request $arg" >&2; exit 1; }
    n="$(db -r '.next')"
    in_clone do_revert "$(field "$arg" .base)" "$(field "$arg" .mergeCommit)" "revert-$arg" || { echo "gh stub: revert failed" >&2; exit 1; }
    save --argjson n "$n" --arg h "revert-$arg" --arg b "$(field "$arg" .base)" --arg t "Revert #$arg" \
      '.next += 1 | .prs += [{number: $n, head: $h, base: $b, title: $t, body: "", state: "OPEN", mergeCommit: null}]'
    note "revert $arg"
    echo "https://github.com/example/fixture/pull/$n"
    ;;

  "pr edit")
    exists "$arg" || { echo "gh stub: no pull request $arg" >&2; exit 1; }
    save --argjson n "$arg" --arg body "$body" '(.prs[] | select(.number == $n)) |= (.body = $body)'
    note "edit $arg"
    ;;

  "pr close")
    save --argjson n "$arg" '(.prs[] | select(.number == $n)) |= (.state = "CLOSED")'
    note "close $arg"
    ;;

  "pr comment" | "issue comment")
    note "comment $group $arg: $body"
    ;;

  "run list")
    b="$(bucket "$commit")"
    if [ "$b" = "fail" ]; then
      id="$(db -r '(.runs | length) + 1')"
      save --arg id "$id" --arg s "$commit" '.runs[$id] = $s'
      jq -n --argjson id "$id" '[{databaseId: $id, conclusion: "failure"}]' | out
    else
      echo '[]' | out
    fi
    ;;

  "run rerun")
    sha="$(db -r --arg id "$arg" '.runs[$id] // empty')"
    [ -n "$sha" ] || { echo "gh stub: no run $arg" >&2; exit 1; }
    save --arg s "$sha" '.reruns[$s] = true'
    note "rerun $sha"
    ;;

  *)
    echo "gh stub: unsupported command: ${pos[*]:-}" >&2
    exit 1
    ;;
esac
exit 0

#!/usr/bin/env bash
# Dry-run stub for git. Everything is passed to the real git, except the
# commands that talk to a remote: push, fetch, pull and ls-remote. Those are
# simulated on the local refs/remotes/origin/* refs, so no network is used.
set -u
REAL="${BACKLOG_LOOP_REAL_GIT:-}"
if [ -z "$REAL" ]; then
  self_dir="$(cd "$(dirname "$0")" && pwd)"
  old_ifs="$IFS"
  IFS=':'
  for d in $PATH; do
    if [ "$d" != "$self_dir" ] && [ -x "$d/git" ]; then REAL="$d/git"; break; fi
  done
  IFS="$old_ifs"
fi
[ -n "$REAL" ] || { echo "git stub: real git not found" >&2; exit 127; }

# Find the subcommand, remembering -C.
dir="."
args=("$@")
i=0
sub=""
while [ "$i" -lt "${#args[@]}" ]; do
  a="${args[$i]}"
  case "$a" in
    -C) dir="${args[$((i + 1))]}"; i=$((i + 2)) ;;
    -c | --git-dir | --work-tree) i=$((i + 2)) ;;
    -*) i=$((i + 1)) ;;
    *) sub="$a"; i=$((i + 1)); break ;;
  esac
done

case "$sub" in
  push | fetch | pull | ls-remote) ;;
  *) exec "$REAL" "$@" ;;
esac

g() { "$REAL" -C "$dir" "$@"; }
rest=("${args[@]:$i}")

case "$sub" in
  fetch | ls-remote) exit 0 ;;

  pull)
    branch=""
    for a in "${rest[@]:-}"; do
      case "$a" in -* | origin | "") ;; *) branch="$a" ;; esac
    done
    [ -n "$branch" ] || branch="$(g rev-parse --abbrev-ref HEAD)"
    g merge -q --ff-only "refs/remotes/origin/$branch"
    ;;

  push)
    force=0
    delete=0
    remote=""
    refs=()
    for a in "${rest[@]:-}"; do
      case "$a" in
        "") ;;
        --force | -f | --force-with-lease*) force=1 ;;
        --delete | -d) delete=1 ;;
        -*) ;;
        *) if [ -z "$remote" ]; then remote="$a"; else refs+=("$a"); fi ;;
      esac
    done
    [ "${#refs[@]}" -gt 0 ] || refs=("$(g rev-parse --abbrev-ref HEAD)")
    for r in "${refs[@]}"; do
      src="${r%%:*}"
      dst="${r##*:}"
      src="${src#+}"
      dst="${dst#refs/heads/}"
      if [ "$delete" -eq 1 ] || [ -z "$src" ]; then
        g update-ref -d "refs/remotes/origin/$dst" || exit 1
        continue
      fi
      sha="$(g rev-parse --verify -q "$src^{commit}")" || { echo "error: src refspec $src does not match any" >&2; exit 1; }
      old="$(g rev-parse --verify -q "refs/remotes/origin/$dst" || true)"
      if [ -n "$old" ] && [ "$force" -eq 0 ] && ! g merge-base --is-ancestor "$old" "$sha"; then
        echo " ! [rejected] $src -> $dst (non-fast-forward)" >&2
        exit 1
      fi
      g update-ref "refs/remotes/origin/$dst" "$sha" || exit 1
    done
    ;;
esac
